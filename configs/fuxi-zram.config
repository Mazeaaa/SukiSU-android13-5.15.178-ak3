# ZRAM 增强：LZ4KD 压缩算法（LZ4K 4K 页剪裁 + Delta 跨页差分）
#
# 由 scripts/lz4kd_setup.py 把源码装到 crypto/lz4kd/ 后，这些开关才会生效。
# 注意：不要动 CONFIG_ZRAM（stock GKI 是 =m，zram.ko 在 system_dlkm），
#      把 zram 改成内建会与厂商 zram.ko 抢同一批符号。
CONFIG_LZ4KD=y
CONFIG_CRYPTO_ACOMP2=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_LZ4HC=y
CONFIG_CRYPTO_ZSTD=y
