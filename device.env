# 目标设备实测参数（2026-11-22，adb 读取）
# 用途：本地构建时 source 本文件，或手工传给 scripts/build.sh

DEVICE_MODEL=2211133C
DEVICE_CODENAME=fuxi
SLOT=_a

# 系统
ROM=OS3.0.318.0.WPCCNXM          # HyperOS 3（Android 16）
SDK=36

# 当前运行内核（第三方：“Wild” 内核，已含 KSU+SUSFS）
# uname -r 被 SUSFS uname 伪造过，/proc/version 才是真实值
CURRENT_KERNEL=5.15.178-android13-Wild
CURRENT_BUILD="#1 SMP PREEMPT Wed Mar 5 04:20:00 UTC 2025"
CURRENT_CLANG="Android clang 14.0.7 (r450784e)"

# 管理器
KSU_MANAGER_PKG=com.sukisu.nova
KSU_MANAGER_VERSION_CODE=35079    # 当前 manager-ci（gitea main 4083 commits → 30000+4083+996）
# 注意：Nova 是「精确相等」匹配，不是 >=。内核 KSU_VERSION 必须等于要装的管理器 versionCode，
#       两者差 1 就叫「版本不匹配」。公式：3*10000 + git rev-list --count HEAD + 996
# 历史：v3.0.0-r1 = 35075（旧版 APK，已弃用）
KSU_MANAGER_VERSION_NAME=manager-ci

# boot 分区
BOOT_PART_BYTES=201326592         # 192MB
BOOT_HEADER_VERSION=4
BOOT_PAGE_SIZE=4096
BOOT_RAMDISK=0                    # ramdisk 在 init_boot，boot 内无
CUR_IMAGE_BYTES=43985408          # 当前 Image ~41.9MB

# 构建用基线
ACK_REF=common-android13-5.15-2025-03
KERNEL_VERSION=5.15.178
STOCK_BOOT_HINT=device/boot_a_current.img   # 当前 boot（已验证可引导+可回滚）

# 关键 config（来自 /proc/config.gz）
#   CONFIG_MODVERSIONS=y  CONFIG_LTO_CLANG_FULL=y  CONFIG_CFI_CLANG=y
#   CONFIG_MODULE_SIG_ALL=y  CONFIG_MODULE_SIG_PROTECT=y
#   CONFIG_ZRAM=m  CONFIG_ZRAM_DEF_COMP="lzo-rle"  CONFIG_CRYPTO_ACOMP2=y
#   CONFIG_KALLSYMS_ALL=y  CONFIG_LOCALVERSION=""  CONFIG_LOCALVERSION_AUTO=y
